# IE 3.3.1 — Configuración de firma del APK de publicación.
#
# 1. Copiar este archivo como `keystore.properties` en la misma carpeta
#    (SanaesenciaApp/keystore.properties).
# 2. Completar los valores con los del keystore propio.
# 3. NUNCA subir ni este archivo completado ni el .jks a GitHub:
#    ambos están en .gitignore.
#
# Para crear el keystore desde la terminal (JDK incluido en Android Studio):
#
#   keytool -genkeypair -v \
#     -keystore sanaesencia-release.jks \
#     -alias sanaesencia \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Sanaesencia, OU=DSY1105, O=Centro Integrativo Sanaesencia, L=Los Vilos, C=CL"
#
# También se puede generar desde Android Studio:
#   Build -> Generate Signed App Bundle / APK -> APK -> Create new...
#
# Alternativa sin archivo: definir las variables de entorno
#   SANAESENCIA_STORE_FILE, SANAESENCIA_STORE_PASSWORD,
#   SANAESENCIA_KEY_ALIAS, SANAESENCIA_KEY_PASSWORD

# Ruta del keystore, relativa a la carpeta SanaesenciaApp/
storeFile=sanaesencia-release.jks
storePassword=CAMBIAR_POR_LA_CLAVE_DEL_KEYSTORE
keyAlias=sanaesencia
keyPassword=CAMBIAR_POR_LA_CLAVE_DE_LA_CLAVE
