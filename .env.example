# Copia este archivo como .env (no se sube a GitHub) y ajusta los valores.

# --- Backend -------------------------------------------------------------
# Clave de firma de los tokens JWT (mínimo 32 caracteres). Obligatoria fuera de desarrollo.
# Genera una con: openssl rand -base64 48
JWT_SECRET=
# Cuentas de demostración con contraseñas públicas: false en cualquier despliegue real
APP_DEMO_SEED=true
# Consola web de H2 (acceso completo a la base de datos): solo en desarrollo
H2_CONSOLE_ENABLED=false

# --- MySQL (perfil "mysql" y docker-compose.yml) ---------------------------
DB_USER=sanaesencia
DB_PASSWORD=sanaesencia
MYSQL_ROOT_PASSWORD=root
# DB_URL=jdbc:mysql://localhost:3307/sanaesencia?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- MEDIlink (RF-14) --------------------------------------------------------
MEDILINK_BASE_URL=
MEDILINK_CITAS_PATH=
MEDILINK_API_KEY=
